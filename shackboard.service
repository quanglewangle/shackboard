[Unit]
Description=Ham Shack Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/peter
ExecStart=/home/peter/shackboard
Restart=on-failure
RestartSec=5

Environment=SHACKBOARD_PORT=8093
Environment=SHACKBOARD_CLUSTER_HOST=dxspider.co.uk:7300
Environment=SHACKBOARD_CLUSTER_CALL=G8GDS
# Required for "worked before" highlighting — a QRZ Logbook Data API key
# (from your QRZ account > Logbook > Settings > API; different from the
# XML lookup key qrzlook uses). Set the real value only on the deployed
# copy of this file, never commit a real secret here.
Environment=SHACKBOARD_QRZ_LOGBOOK_KEY=changeme

[Install]
WantedBy=default.target
